---
import Container from "../components/ui/Container.astro";
import company from "../data/company.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";

const phoneHref = company.phone.replace(/[^\d+]/g, "");
const mobileHref = company.mobile.replace(/[^\d+]/g, "");
---

<BaseLayout
  title={makePageTitle("联系我们")}
  description={`联系${company.name}：电话 ${company.phone}、手机 ${company.mobile}、邮箱 ${company.email}，工厂位于东莞塘厦。`}
>
  <section class="border-b border-[var(--color-line)] bg-white py-20 sm:py-24">
    <Container>
      <p class="eyebrow mb-5">联系我们</p>
      <h1 class="max-w-4xl text-4xl font-extrabold leading-[1.14] sm:text-6xl">把设备参数发给我们，一起评估电池方案</h1>
      <p class="mt-7 max-w-2xl text-xl leading-9 text-[var(--color-muted)]">
        支持 OEM 贴牌代工与 ODM 定制开发。工作时间内可直接致电，或用邮箱发送需求与用量说明。
      </p>
    </Container>
  </section>

  <section class="py-20 sm:py-24">
    <Container class="grid gap-6 lg:grid-cols-3">
      <a href={`tel:${phoneHref}`} class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-8 transition hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
        <p class="eyebrow">固话</p>
        <h2 class="mt-4 text-2xl font-extrabold">{company.phone}</h2>
        <p class="mt-3 text-[var(--color-muted)]">东莞塘厦生产基地</p>
      </a>
      <a href={`tel:${mobileHref}`} class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-8 transition hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
        <p class="eyebrow">手机 / 微信同号</p>
        <h2 class="mt-4 text-2xl font-extrabold">{company.mobile}</h2>
        <p class="mt-3 text-[var(--color-muted)]">业务对接</p>
      </a>
      <a href={`mailto:${company.email}`} class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-8 transition hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
        <p class="eyebrow">邮箱</p>
        <h2 class="mt-4 break-all text-xl font-extrabold">{company.email}</h2>
        <p class="mt-3 text-[var(--color-muted)]">发送需求与图纸</p>
      </a>
    </Container>
  </section>

  <section class="pb-20 sm:pb-24">
    <Container class="grid gap-6 lg:grid-cols-2">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-primary)] p-8 text-white sm:p-10">
        <p class="text-xs font-extrabold tracking-[0.16em] text-white/70">东莞工厂</p>
        <h2 class="mt-4 text-2xl font-extrabold leading-9">{company.address}</h2>
        <p class="mt-3 text-white/70">动力与储能锂电池生产基地</p>
      </div>
      <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-8 sm:p-10">
        <p class="eyebrow">深圳办公室</p>
        <h2 class="mt-4 text-xl font-extrabold leading-8">{company.shenzhenOffice}</h2>
        <p class="mt-3 text-[var(--color-muted)]">中国总部</p>
      </div>
    </Container>
  </section>

  <section class="pb-24 sm:pb-32">
    <Container>
      <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-8 sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-12">
        <div class="max-w-2xl">
          <p class="eyebrow">线上店铺</p>
          <h2 class="mt-4 text-2xl font-extrabold">阿里巴巴国际站与 1688 店铺同步展示产品</h2>
          <p class="mt-3 text-[var(--color-muted)]">可在线查看产品分类与询价，也可直接联系我们获取报价单。</p>
        </div>
        <a href={company.alibaba} rel="noopener" target="_blank" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-[var(--color-primary-dark)] lg:mt-0">
          访问阿里巴巴店铺
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
