---
import { getPublishedProducts } from "../../lib/products";
import ProductCard from "../product/ProductCard.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const products = (await getPublishedProducts()).filter((product) => product.data.featured).slice(0, 3);
---

<section class="border-y border-[var(--color-line)] bg-white py-24 sm:py-32">
  <Container>
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="核心业务"
        title="三大业务板块，覆盖不同用电需求"
        description="动力锂电、铅改锂电池与家用储能电池分别面向不同设备与场景，可按客户需求提供 OEM 贴牌代工与 ODM 定制开发。"
      />
      <Button href="/products/" variant="secondary" class="shrink-0">查看全部产品</Button>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </Container>
</section>
